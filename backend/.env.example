# ==============================================================================
# WhatsApp Business Cloud API (Meta) Configuration
# ==============================================================================
# NOTE: Changing any of these variables requires restarting the backend server
# and outbox worker, or redeploying the application in production.
#
# WHATSAPP_SENDER_NUMBER:
#   The registered human-readable WhatsApp Business phone number with country code.
#   Example: +91 99951 91108 or +919995191108
#   This is the number customers see as the sender. It must match the number
#   registered with Meta for the WHATSAPP_PHONE_NUMBER_ID below.
WHATSAPP_SENDER_NUMBER=

# WHATSAPP_PHONE_NUMBER_ID:
#   Meta's unique numeric identifier for the registered phone number in your
#   WhatsApp Business Account (WABA). Found in Meta Developer Dashboard under
#   WhatsApp > API Setup > Phone number ID.
#   NOTE: This is NOT the phone number itself. Requests are sent using this ID.
WHATSAPP_PHONE_NUMBER_ID=

# WHATSAPP_ACCESS_TOKEN:
#   System User or Permanent Access Token authorized with 'whatsapp_business_messaging'
#   and 'whatsapp_business_management' permissions. Kept strictly on the backend.
WHATSAPP_ACCESS_TOKEN=

# WHATSAPP_API_VERSION:
#   Supported Meta Graph API version verified against official Meta documentation.
#   Current active version: v27.0 (defaults to v27.0).
WHATSAPP_API_VERSION=v27.0

# WHATSAPP_WEBHOOK_VERIFY_TOKEN:
#   Arbitrary secret string configured in Meta Webhook dashboard to verify ownership
#   during initial GET webhook handshake.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# WHATSAPP_APP_SECRET:
#   Meta App Secret from App Dashboard > App settings > Basic. Used by the backend to
#   validate HMAC-SHA256 signatures on incoming webhook status callbacks.
WHATSAPP_APP_SECRET=

ADMIN_NAME=Sifon Admin
ADMIN_EMAIL=admin@sifon.local
ADMIN_INITIAL_PASSWORD=Sifon@123
